# Copy to .env (git-ignored) and fill in. Never commit real keys.

# Free key: https://fred.stlouisfed.org/docs/api/api_key.html  (FRED + ALFRED vintages)
FRED_API_KEY=

# Optional (P1 cross-check provider, not used by default): https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# Required only for the P2 SEC EDGAR extension: "<app name> <contact email>"
SEC_USER_AGENT=
